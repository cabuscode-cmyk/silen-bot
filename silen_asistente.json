    {
      "parameters": {
        "jsCode": "const items = $input.all();\nif (items.length === 0) {\n  return [];\n}\n\nfunction horaDe(ev) {\n  const inicio = (ev.start && ev.start.dateTime) || '';\n  return inicio.includes('T') ? inicio.substring(11, 16) : null;\n}\n\nif (items.length === 1) {\n  const ev = items[0].json;\n  const hora = horaDe(ev);\n  const horaTxt = hora ? ` a las ${hora}` : '';\n  const desc = ev.description ? ` ${ev.description}.` : '';\n  return [{ json: { mensaje: `Hoy tienes ${ev.summary || 'una cita'}${horaTxt}.${desc} No te olvides.` } }];\n}\n\nconst partes = items.map(i => {\n  const ev = i.json;\n  const hora = horaDe(ev);\n  return `${ev.summary || 'una cita'}${hora ? ' a las ' + hora : ''}`;\n});\nconst listado = partes.slice(0, -1).join(', ') + ' y ' + partes[partes.length - 1];\n\nreturn [{ json: { mensaje: `Hoy tienes ${items.length} citas: ${listado}. No te olvides.` } }];"
      },

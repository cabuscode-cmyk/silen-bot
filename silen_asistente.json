    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst mesesAbrev = ['ene','feb','mar','abr','may','jun','jul','ago','sep','oct','nov','dic'];\nconst diasSemana = ['lunes','martes','miércoles','jueves','viernes','sábado','domingo'];\nconst tz = 'Europe/Madrid';\n\nif (items.length === 0) {\n  return [{ json: { mensaje: '🗓 *Tu agenda para los próximos 7 días:*\\n\\nNo tienes nada agendado. ¡Semana libre!' } }];\n}\n\nconst bloques = items.map(i => {\n  const ev = i.json;\n  const inicioRaw = (ev.start && (ev.start.dateTime || ev.start.date)) || '';\n  const esTodoDia = inicioRaw && !inicioRaw.includes('T');\n  const fecha = DateTime.fromISO(inicioRaw, { zone: tz });\n  const diaSemana = fecha.isValid ? diasSemana[fecha.weekday - 1] : '';\n  const mes = fecha.isValid ? mesesAbrev[fecha.month - 1] : '';\n  const fechaTexto = fecha.isValid ? `${diaSemana} ${fecha.day} ${mes}` : '';\n  const horaTexto = esTodoDia ? 'todo el día' : (fecha.isValid ? fecha.toFormat('HH:mm') : '');\n  return `• ${ev.summary || 'Sin título'}\\n  ${fechaTexto} — ${horaTexto}`;\n});\n\nreturn [{ json: { mensaje: '🗓 *Tu agenda para los próximos 7 días:*\\n\\n' + bloques.join('\\n\\n') } }];"
      },
